# Usually leave both values unchanged. The network helper detects a directly
# attached public IP on a VPS, or uses UPnP on a home network.
QAPP_BACKEND_PUBLIC_HOST=
QAPP_BACKEND_UPNP=true

PRIVATE_TRANSPORT_PORT=4445
CALL_MEDIA_PORT=4446

# Set QAPP_BACKEND_PUBLIC_HOST to a literal public IP when automatic detection
# cannot work, such as a VPS behind provider-managed NAT. In that case, arrange
# the matching UDP forwarding separately and set QAPP_BACKEND_UPNP=false.
